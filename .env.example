SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Optional. Plaintext passphrase for the lightweight shared access gate (see
# docs/no-auth-deployment.md). Only its SHA-256 hash is ever built into the
# app -- the deploy workflow hashes this secret, it never ships the plaintext.
# Leave unset/empty to disable the gate entirely.
ACCESS_PASSPHRASE=changeme
